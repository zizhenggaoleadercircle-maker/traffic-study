# Copy this file to `.env` and set DATABASE_URL to match your local PostgreSQL.
#
# DBeaver: Edit Connection > Main tab — use the same values here:
#   Host     -> HOST in the URL (often localhost or 127.0.0.1)
#   Port     -> PORT (default 5432)
#   Database -> DATABASE path after the final /
#   Username -> USER in the URL
#   Password -> PASSWORD in the URL (see below if it has special characters)
#
# URL shape:
#   postgresql://USER:PASSWORD@HOST:PORT/DATABASE
#
# If PASSWORD contains @ : / # ? & or spaces, percent-encode it in the URL
# (e.g. @ -> %40). DBeaver shows the raw password; the URL must use encoding.
#
# Local PostgreSQL usually does not need SSL. Add ?sslmode=require only if your
# server requires TLS.
#
# Example matches typical local DBeaver defaults: host localhost, port 5432, db postgres.
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/postgres
